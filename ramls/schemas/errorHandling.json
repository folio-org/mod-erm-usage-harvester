{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ErrorHandling Schema",
  "description": "Harvester error handling settings. An option that is not set uses its default, see /erm-usage-harvester/error-handling/defaults",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "maxFailedAttempts": {
      "description": "Number of failed attempts",
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "code1000": {
      "description": "1000 - Service Not Available",
      "type": "object",
      "properties": {
        "waitMinutes": {
          "description": "Wait time in minutes before the next attempt",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "required": [
        "waitMinutes"
      ],
      "additionalProperties": false
    },
    "code1010": {
      "description": "1010 - Service Busy",
      "type": "object",
      "properties": {
        "waitMinutes": {
          "description": "Wait time in minutes before the next attempt",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "required": [
        "waitMinutes"
      ],
      "additionalProperties": false
    },
    "code1011": {
      "description": "1011 - Report Queued for Processing",
      "type": "object",
      "properties": {
        "waitMinutes": {
          "description": "Wait time in minutes before the next attempt",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "required": [
        "waitMinutes"
      ],
      "additionalProperties": false
    },
    "code1020": {
      "description": "1020 - Client has made too many requests",
      "type": "object",
      "properties": {
        "numberOfRequests": {
          "description": "Number of requests",
          "type": "integer",
          "minimum": 1
        },
        "timeframeSeconds": {
          "description": "Timeframe in seconds",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "numberOfRequests",
        "timeframeSeconds"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
