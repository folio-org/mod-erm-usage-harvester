{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ErrorHandling Schema",
  "description": "Harvester error handling settings",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "numberOfFailedAttempts": {
      "description": "Number of failed attempts",
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    },
    "serviceNotAvailable": {
      "description": "1000 - Service Not Available",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the configured wait time is used",
          "type": "boolean",
          "default": false
        },
        "waitTime": {
          "description": "Wait time in minutes before the next attempt",
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 1440
        }
      },
      "additionalProperties": false
    },
    "serviceBusy": {
      "description": "1010 - Service Busy",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the configured wait time is used",
          "type": "boolean",
          "default": false
        },
        "waitTime": {
          "description": "Wait time in minutes before the next attempt",
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 1440
        }
      },
      "additionalProperties": false
    },
    "reportQueuedForProcessing": {
      "description": "1011 - Report Queued for Processing",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the configured wait time is used",
          "type": "boolean",
          "default": false
        },
        "waitTime": {
          "description": "Wait time in minutes before the next attempt",
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 1440
        }
      },
      "additionalProperties": false
    },
    "tooManyRequests": {
      "description": "1020 - Client has made too many requests",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the configured request rate is used",
          "type": "boolean",
          "default": false
        },
        "numberOfRequests": {
          "description": "Number of requests",
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "timeframe": {
          "description": "Timeframe in seconds",
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
